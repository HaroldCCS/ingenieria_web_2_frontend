# Variables públicas de Vite (quedan en el JavaScript que descarga el navegador).
# NUNCA ponga aquí claves privadas, tokens ni contraseñas.
#
# Vacía: el frontend usa rutas relativas (/api/v1/...).
#  - En Docker Compose, Nginx reenvía /api a la API.
#  - En `pnpm dev`, el proxy de vite.config.ts reenvía /api a VITE_DEV_API_TARGET.
VITE_API_BASE_URL=

# Solo para `pnpm dev` (no se incrusta en el build): dónde corre la API local
VITE_DEV_API_TARGET=http://localhost:8000
